{
  "$schema": "https://opencode.ai/theme.json",
  "base": {
    "categorical": ["accent", "green", "blue", "purple", "cyan", "orange"],
    "text": {
      "base": "#f0e8da",
      "muted": "#b5aa98",
      "faint": "#b5aa98",
      "action": {
        "primary": {"base": "#bdb087", "$hovered": "#f0e8da", "$disabled": "#a49b8c"},
        "secondary": {"base": "#f0e8da", "$hovered": "#f8f0e2"},
        "destructive": {"base": "#cb8978", "$hovered": "#dda08f"}
      },
      "formfield": {"base": "#f0e8da", "$disabled": "#a49b8c"},
      "feedback": {
        "error": {"base": "#cb8978"},
        "warning": {"base": "#c5b582"},
        "success": {"base": "#a3ad86"},
        "info": {"base": "#91aabd"}
      }
    },
    "background": {
      "base": "#181715",
      "raised": {"base": "#1f1d1a", "high": "#22201d", "max": "#38332b"},
      "action": {
        "primary": {"base": "#22201d", "$hovered": "#38332b", "$selected": "#38332b"},
        "secondary": {"base": "#1f1d1a", "$hovered": "#38332b"},
        "destructive": {"base": "#49312b", "$hovered": "#593b33"}
      },
      "formfield": {"base": "#1f1d1a", "$focused": "#22201d", "$selected": "#38332b"},
      "feedback": {
        "error": {"base": "#3c2c28"},
        "warning": {"base": "#393428"},
        "success": {"base": "#30362a"},
        "info": {"base": "#2c3237"}
      }
    },
    "border": {"base": "#6f685a"},
    "scrollbar": {"base": "#6f685a"},
    "diff": {
      "text": {"added": "#b0c39e", "removed": "#dda08f", "context": "#f0e8da", "hunkHeader": "#91aabd"},
      "background": {"added": "#30362a", "removed": "#3c2c28", "context": "#181715"},
      "highlight": {"added": "#414b35", "removed": "#593b33"},
      "lineNumber": {"text": "#b5aa98", "background": {"added": "#30362a", "removed": "#3c2c28"}}
    },
    "syntax": {
      "comment": "#b5aa98", "keyword": "#b59aaf", "function": "#bdb087",
      "variable": "#f0e8da", "string": "#a3ad86", "number": "#ce9a70",
      "type": "#91aabd", "operator": "#c5b582", "punctuation": "#b5aa98"
    },
    "markdown": {
      "text": "#f0e8da", "heading": "#bdb087", "link": "#91aabd",
      "linkText": "#88b3ab", "code": "#c5b582", "blockQuote": "#b5aa98",
      "emphasis": "#f5eddf", "strong": "#f8f0e2", "horizontalRule": "#a49b8c",
      "listItem": "#bdb087", "listEnumeration": "#bdb087", "image": "#b59aaf",
      "imageText": "#88b3ab", "codeBlock": "#f0e8da"
    }
  },
  "dark": {
    "hue": {
      "gray": {"100":"#f8f0e2","200":"#f0e8da","300":"#d5cbbb","400":"#b5aa98","500":"#847b6c","600":"#6f685a","700":"#38332b","800":"#22201d","900":"#181715"},
      "red": {"100":"#eed1c5","200":"#dda08f","300":"#cb8978","400":"#bc7968","500":"#a86959","600":"#815144","700":"#593b33","800":"#3c2c28","900":"#282724"},
      "orange": {"100":"#eed9c3","200":"#deaf88","300":"#ce9a70","400":"#be8b62","500":"#a87954","600":"#805d40","700":"#58432f","800":"#3d3026","900":"#282724"},
      "yellow": {"100":"#eee4c6","200":"#dcc88f","300":"#c5b582","400":"#bdb087","500":"#a0956d","600":"#7c7354","700":"#554f39","800":"#393428","900":"#282724"},
      "green": {"100":"#dce4ca","200":"#b0c39e","300":"#a3ad86","400":"#949f77","500":"#7f8966","600":"#626d4f","700":"#414b35","800":"#30362a","900":"#282724"},
      "cyan": {"100":"#d1e4de","200":"#9dc9c1","300":"#88b3ab","400":"#79a49b","500":"#658d84","600":"#4e6c65","700":"#354c46","800":"#2b3531","900":"#282724"},
      "blue": {"100":"#d9e2e8","200":"#a9c0d2","300":"#91aabd","400":"#819bae","500":"#6d8498","600":"#536775","700":"#3b4953","800":"#2c3237","900":"#282724"},
      "purple": {"100":"#e7dbe3","200":"#cdb1c6","300":"#b59aaf","400":"#a58a9e","500":"#8e7488","600":"#6e5a69","700":"#4e414b","800":"#352e33","900":"#282724"},
      "accent": "$hue.yellow",
      "interactive": "$hue.yellow",
      "neutral": "$hue.gray"
    }
  }
}
